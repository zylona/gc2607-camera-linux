# Maintainer: Zylona <zylooona at gmail dot com>
# Contributor: Alexander Daichendt <claude at daichendt dot one>
#
# On-demand virtual webcam integration for the GC2607 camera stack.
#
# Ships the tested user-level relayd engine, v4l2loopback configuration, the
# hardware gate, and desktop camera metadata.
pkgname=gc2607-virtual-camera-git
pkgver=r60.gf46a1f1
pkgrel=1
pkgdesc="GC2607 on-demand virtual webcam (v4l2-relayd) and system camera config"
arch=('any')
url="https://github.com/zylona/gc2607-camera-linux"
license=('GPL2')
depends=(
  'gc2607-dkms'
  'gc2607-ipu-bridge-dkms'
  'gc2607-ipu6-camera-hal'
  # PSYS (/dev/ipu-psys0) — the out-of-tree intel-ipu6-psys module. Also pulled
  # transitively by gc2607-ipu6-camera-hal -> intel-ipu6-camera-bin; listed here
  # because the relayd pipeline needs the device at runtime.
  'intel-ipu6-dkms-git'
  'icamerasrc-git'
  'v4l2-relayd'
  'v4l2loopback-dkms'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
)
makedepends=('git')
provides=('gc2607-virtual-camera')
conflicts=('gc2607-virtual-camera')
install=gc2607-virtual-camera.install
source=("git+https://github.com/zylona/gc2607-camera-linux.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/gc2607-camera-linux"
  printf 'r%s.g%s' \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

package() {
  cd "${srcdir}/gc2607-camera-linux"

  # v4l2loopback: autoload at boot + the GC2607-labelled device options.
  install -Dm644 config/modprobe.d/gc2607-v4l2loopback.conf \
    "${pkgdir}/usr/lib/modprobe.d/gc2607-v4l2loopback.conf"
  install -Dm644 /dev/stdin \
    "${pkgdir}/usr/lib/modules-load.d/gc2607-v4l2loopback.conf" <<'EOF'
# Auto-load the v4l2loopback module at boot for the GC2607 virtual camera.
v4l2loopback
EOF

  # icamerasrc-git already owns the IPU6 PSYS rule. Do not install a second
  # file at the same path; pacman correctly rejects two packages owning it.

  # Desktop integration. This only prioritizes the virtual camera; it does not
  # globally disable unrelated IPU6 or libcamera nodes.
  install -Dm644 config/wireplumber/50-gc2607-virtual-camera.conf \
    "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/50-gc2607-virtual-camera.conf"

  # Install the tested scripts under a stable prefix. Keeping the scripts
  # together preserves their ROOT-relative lookups after the source checkout
  # is gone.
  install -dm755 "${pkgdir}/usr/lib/gc2607-camera/scripts"
  install -m755 \
    scripts/check-gc2607-hardware.sh \
    scripts/run-virtual-camera-feeder.sh \
    scripts/run-virtual-camera-supervisor.sh \
    scripts/virtual-camera.sh \
    "${pkgdir}/usr/lib/gc2607-camera/scripts/"

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/gc2607-camera" <<'EOF'
#!/usr/bin/env bash
exec /usr/lib/gc2607-camera/scripts/virtual-camera.sh "$@"
EOF

  install -Dm644 /dev/stdin \
    "${pkgdir}/usr/lib/systemd/user/gc2607-camera.service" <<'EOF'
[Unit]
Description=GC2607 on-demand virtual camera (v4l2-relayd engine)
Documentation=https://github.com/zylona/gc2607-camera-linux
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecCondition=/usr/bin/bash /usr/lib/gc2607-camera/scripts/check-gc2607-hardware.sh
ExecStart=/usr/lib/gc2607-camera/scripts/virtual-camera.sh run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
}
