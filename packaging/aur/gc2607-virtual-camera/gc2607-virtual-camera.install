_apply() {
  depmod -a 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger -s misc 2>/dev/null || true

  # Bring the loopback up now with the packaged options so /dev/video60 exists
  # without a reboot. Harmless if already loaded.
  modprobe v4l2loopback 2>/dev/null || true

  systemctl --global enable gc2607-camera.service 2>/dev/null || true
}

post_install() {
  _apply
  cat <<'EOF'
==> GC2607 virtual camera installed.
    The user service is globally enabled and will start on the next login.
    To activate it in the current graphical session, run:

      systemctl --user daemon-reload
      systemctl --user enable --now gc2607-camera.service

    "GC2607 Virtual Camera" (/dev/video60) is selectable in applications;
    the real sensor only powers on while an app holds the device open.

    The DKMS modules (sensor, ipu-bridge, PSYS) replace in-use kernel modules,
    so a reboot is recommended for a clean first bring-up. After that the whole
    stack comes up automatically on boot.
EOF
}

post_upgrade() {
  _apply
}

pre_remove() {
  systemctl --global disable gc2607-camera.service 2>/dev/null || true
}

post_remove() {
  depmod -a 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
}
